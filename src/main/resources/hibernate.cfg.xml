          jdbc:mysql://localhost:3306/ems_db?useSSL=false&amp;allowPublicKeyRetrieval=true
      </property>
      <property name="hibernate.connection.username">root</property>
      <property name="hibernate.connection.password">Nadu@06&amp;13</property>
      <property name="hibernate.hbm2ddl.auto">update</property>
      <property name="hibernate.show_sql">true</property>

      <mapping class="jiat.ems_pro.entity.Employee"/>
      <mapping class="jiat.ems_pro.entity.Role"/>
